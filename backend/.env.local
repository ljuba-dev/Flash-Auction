#Create a copy of this file and name it `.env` and change parameters if needed
# Server envs
PORT=3000
# Postgress envs
PG_USER=postgres
PG_HOST=localhost
# if running locally and not via docker-compose.yml
# put here password for your PostgreSQL
PG_PASSWORD=ljuba988
PG_PORT=5432
PG_DB=auction
# Redis envs
REDIS_URL=redis://redisuser:redissecretpassword@localhost:6379
# Set in redis ACL SETUSER also
# redis-cli
# ACL SETUSER redisuser on >redissecretpassword ~* &* +@all
# Database instructions
#SEED=true
#CLEAR_DATA=true
# RabbitMQ
AMQP_URL=amqp://localhost
# BUILD CAN BE: normal, redis, mq
# normal - Runs Server & PostGreSQL
# redis - Runs normal + Redis for caching and bid checks and inserts
# mq - Runs redis + rabbitMQ for updating and inserting data into db
BUILD=mq
# Testing variables
TESTING=true# to le† system know if we are running tests
# Misc
SHOW_LOGS=true# show console.logs for easier debugging